SQL_SERVER=tcp:vivela.database.windows.net,1433
SQL_DATABASE=dwh
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=yes
SQL_TRUST_CERT=no
SQL_CONNECTION_TIMEOUT=30
# Authentication modes supported by this project:
# - SQL authentication: SQL_USERNAME and SQL_PASSWORD
# - Azure AD password authentication: SQL_AUTHENTICATION=ActiveDirectoryPassword plus SQL_USERNAME and SQL_PASSWORD
# SQL_AUTHENTICATION=ActiveDirectoryPassword